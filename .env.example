TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Optional: higher rate limits on data.gov.sg
DATA_GOV_API_KEY=
# Morning check-in (Asia/Singapore)
MORNING_HOUR=6
MORNING_MINUTE=30
# Pull latest model from git before morning ask
GIT_PULL_BEFORE_MORNING=true
# Outdoor OK if predicted 1-hr PM2.5 (µg/m³) is at or below this
OUTDOOR_PM25_MAX=55
# SQLite path for user prefs (bot host only)
DATABASE_PATH=data/bot.db
# Reject new model if MAE is worse than previous by more than this fraction
RETRAIN_MAX_MAE_REGRESSION=0.15